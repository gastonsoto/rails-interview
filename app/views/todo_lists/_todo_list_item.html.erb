<%# locals: todo_list:, item: %>
<li class="item <%= "item--closed" if item.status == "closed" %>">
  <label class="item__checkbox">
    <input
      type="checkbox"
      data-item-select
      data-item-id="<%= item.id %>"
      data-todo-list-id="<%= todo_list.id %>"
      data-action="change->todo-lists#toggleSelected"
      aria-label="Select item"
    />
    <span class="item__checkmark"></span>
  </label>

  <label class="item__checkbox">
    <input
      type="checkbox"
      <%= "checked" if item.status == "closed" %>
      data-item-id="<%= item.id %>"
      data-todo-list-id="<%= todo_list.id %>"
      data-action="change->todo-lists#toggleItem"
      aria-label="Toggle item"
    />
    <span class="item__checkmark"></span>
  </label>

  <input
    class="item__input"
    value="<%= item.description %>"
    data-item-id="<%= item.id %>"
    data-todo-list-id="<%= todo_list.id %>"
    data-action="blur->todo-lists#editItemDescription"
    aria-label="Todo item description"
  />

  <button
    type="button"
    class="icon-btn item__trash"
    title="Remove"
    aria-label="Remove"
    data-item-delete
    data-item-id="<%= item.id %>"
    data-todo-list-id="<%= todo_list.id %>"
    data-action="click->todo-lists#deleteItem"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 3h6m-8 4h10m-9 0 1 14h6l1-14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 11v7M14 11v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>
</li>

