<div class="page page--soft" data-controller="todo-lists">
  <header class="page__header">
    <div>
      <h1 class="title">Todo Lists</h1>
      <p class="subtitle">Quick edits, checkboxes, and fast add — powered by your API.</p>
    </div>
    <%= link_to 'Add Todo List', new_todo_list_path, class: "btn btn--primary" %>
  </header>

  <%= turbo_stream_from "todo_lists" %>
  <%= render partial: "todo_lists/todo_lists", locals: { todo_lists: @todo_lists } %>
</div>
